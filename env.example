# PayPal Configuration
# Get your PayPal Client ID from https://developer.paypal.com/
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# PayPal Environment (sandbox or production)
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# Store Configuration (Optional - can be overridden in lib/config.ts)
NEXT_PUBLIC_STORE_NAME="Your Store Name"
NEXT_PUBLIC_STORE_TAGLINE="Your Store Tagline"
NEXT_PUBLIC_STORE_DESCRIPTION="Your store description"
NEXT_PUBLIC_STORE_LOGO="/your-logo.svg"
